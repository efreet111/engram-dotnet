# ─────────────────────────────────────────────────────────────────────────────
# Engram — Environment Variables
#
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env
#
# NUNCA commitear el archivo .env (está en .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Deployment Profile ──────────────────────────────────────────────────────
# Reemplaza configuración manual de 10+ variables. Elegí uno:
#
#   local   → SQLite, sync off — desarrollo individual
#             Requiere: nada más
#
#   server  → PostgreSQL, sync off — equipo chico con DB compartida
#             Requiere: ENGRAM_PG_*, ENGRAM_USER
#
#   sync    → PostgreSQL + SyncManager — equipo grande offline-first
#             Requiere: ENGRAM_PG_*, ENGRAM_SERVER_URL, ENGRAM_USER
#
# El perfil define defaults; podés pisar cualquier var individual.
# Si no se setea, el default es "local" (backward-compatible).
ENGRAM_PROFILE=local

# ─── Database Mode ───────────────────────────────────────────────────────────
# Cómo se accede a PostgreSQL desde Docker:
#
#   external  → PostgreSQL en el host o red externa (usa ENGRAM_PG_HOST)
#               Usa docker-compose.yml con --profile vacuum (sin postgres)
#
#   embedded  → PostgreSQL se levanta como servicio dentro de este compose
#               Usa docker-compose.embedded.yml o --profile embedded
#               ENGRAM_PG_HOST debe ser "postgres" (nombre del servicio)
#
# Default: external (backward-compatible)
ENGRAM_DB_MODE=external

# ─── Data Volume (SQLite only) ───────────────────────────────────────────────
# Ruta en el HOST donde se almacenan los datos persistentes (SQLite, exports)
# El contenedor monta esta ruta en /data/engram
#
# REQUIRED for SQLite backend (docker-compose.sqlite.yml)
# OPTIONAL for PostgreSQL backend (docker-compose.postgres.yml) — ignored
#
# Ejemplos:
#   - ./data                          (relativo al docker-compose.yml)
#   - /var/lib/engram                 (Linux estándar)
#   - /mnt/mydata/engram              (disco externo / NAS)
ENGRAM_DATA_DIR_HOST=./data

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Host del PostgreSQL
# Opciones:
#   - host.docker.internal  (PostgreSQL en el mismo host que Docker)
#   - postgres              (PostgreSQL en otro contenedor de la misma red)
#   - db.example.com        (PostgreSQL remoto)
#   - 192.168.x.x           (IP directa de tu servidor PostgreSQL)
ENGRAM_PG_HOST=host.docker.internal

# Puerto de PostgreSQL
ENGRAM_PG_PORT=5432

# Nombre de la base de datos
ENGRAM_PG_DATABASE=engram

# Usuario de PostgreSQL
ENGRAM_PG_USER=engram

# Password de PostgreSQL (OBLIGATORIO - cambiar por tu password real)
ENGRAM_PG_PASSWORD=REPLACE_ME

# ─── Backend Selection ───────────────────────────────────────────────────────
# Valores: postgres | sqlite
# El perfil define el default (local→sqlite, server/sync→postgres).
# Podés pisarlo acá si necesitás un backend distinto al del perfil.
ENGRAM_DB_TYPE=postgres

# ─── Team Isolation (required for server/sync profiles) ──────────────────────
# Identifica al desarrollador en equipos multi-usuario.
# Obligatorio si ENGRAM_PROFILE=server o sync.
# No necesario para perfil local.
# ENGRAM_USER=your.name

# ─── Opcional ────────────────────────────────────────────────────────────────
# JWT Secret para autenticación (descomentar para habilitar)
# ENGRAM_JWT_SECRET=your-secure-secret-key-here

# CORS Origins para acceso web (descomentar y ajustar si es necesario)
# ENGRAM_CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# ─── Cliente MCP (cada desarrollador — NO van en este .env del servidor) ─────
# Estas variables van en el mcp.json de cada desarrollador, NO en el .env del servidor.
# Ver docs/SYNC-SETUP.md para más detalles.
#
# ENGRAM_DATA_DIR=~/.engram
# ENGRAM_SERVER_URL=http://your-server:7437
# ENGRAM_SYNC_ENABLED=true
# ENGRAM_USER=your.name   # obligatorio en equipos
